{
  "name": "@mariachi/worker",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "@mariachi/jobs": "workspace:*",
    "@mariachi/lifecycle": "workspace:*",
    "@mariachi/config": "workspace:*",
    "@mariachi/observability": "workspace:*",
    "zod": "^3.24"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8"
  }
}
