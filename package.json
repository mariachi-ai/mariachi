{
  "name": "mariachi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter='!./apps/*' --filter='!./examples/*'",
    "dev": "turbo run dev",
    "explore:dev": "pnpm --filter @mariachi/explorer dev",
    "explore:build": "turbo run build --filter=@mariachi/explorer",
    "explore:test": "pnpm --filter @mariachi/explorer test:browser",
    "explore:visual": "pnpm --filter @mariachi/explorer test:visual",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "turbo run test:integration --concurrency=1 --filter='!./apps/*' --filter='!./examples/*'",
    "lint": "turbo run lint --filter='!./apps/*' --filter='!./examples/*' && pnpm run lint:conventions",
    "lint:conventions": "node scripts/lint-conventions.mjs",
    "docs:check": "node scripts/check-docs-links.mjs && node scripts/generate-catalog.mjs --check && node scripts/generate-design-catalog.mjs --check",
    "docs:catalog": "node scripts/generate-catalog.mjs && node scripts/generate-design-catalog.mjs",
    "clean": "turbo run clean",
    "typecheck": "turbo run typecheck --filter='!./apps/*' --filter='!./examples/*'",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27",
    "@playwright/test": "1.64.1",
    "@types/node": "^22",
    "testcontainers": "^10",
    "tsup": "^8",
    "turbo": "^2.8.10",
    "typescript": "^5.7",
    "vitest": "^3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
