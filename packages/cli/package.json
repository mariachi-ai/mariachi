{
  "name": "@mariachi/cli",
  "version": "0.0.5",
  "description": "The mariachi binary: init, generate, validate, db (generate, check, migrate, seed), design and explore.",
  "mariachi": {
    "category": "tooling",
    "status": "beta",
    "useWhen": "Creating projects, generating code, running migrations, building design themes, browsing the explorer",
    "entry": []
  },
  "type": "module",
  "bin": {
    "mariachi": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./program": {
      "types": "./dist/program.d.ts",
      "import": "./dist/program.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/config": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/create": "workspace:*",
    "@mariachi/database": "workspace:*",
    "@mariachi/database-postgres": "workspace:*",
    "commander": "^13",
    "drizzle-kit": "^0.30",
    "jiti": "^2.4",
    "@mariachi/design": "workspace:*"
  },
  "peerDependencies": {
    "@mariachi/explorer": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@mariachi/explorer": {
      "optional": true
    }
  },
  "devDependencies": {
    "drizzle-orm": "^0.38",
    "postgres": "^3.4",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
