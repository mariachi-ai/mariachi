{
  "name": "@mariachi/ai",
  "version": "0.0.5",
  "description": "LLM sessions persisted in Postgres, with token budgets, streaming, tools, agents, RAG, provider fallback and cost tracking.",
  "mariachi": {
    "category": "domain",
    "status": "beta",
    "useWhen": "Calling language models",
    "entry": [
      "createAI",
      "DefaultAI",
      "AnthropicAdapter",
      "FallbackAdapter",
      "runAgent"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js",
      "require": "./dist/postgres.cjs"
    },
    "./anthropic": {
      "types": "./dist/anthropic.d.ts",
      "import": "./dist/anthropic.js",
      "require": "./dist/anthropic.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.73",
    "@mariachi/core": "workspace:*",
    "@mariachi/database": "workspace:*",
    "ai": "^7.0.112",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@mariachi/database-postgres": "workspace:*",
    "drizzle-orm": "^0.38",
    "@ai-sdk/anthropic": "^4"
  },
  "peerDependenciesMeta": {
    "@mariachi/database-postgres": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "@ai-sdk/anthropic": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.61",
    "@mariachi/database-postgres": "workspace:*",
    "drizzle-orm": "^0.38",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
