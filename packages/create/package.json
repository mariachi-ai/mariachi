{
  "name": "@mariachi/create",
  "version": "0.1.0",
  "description": "Project scaffolding, generators and architecture validation used by the CLI.",
  "mariachi": {
    "category": "tooling",
    "status": "beta",
    "useWhen": "Programmatic scaffolding; most users run the CLI instead",
    "entry": [
      "createProject",
      "generateEntity",
      "validate"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*"
  },
  "devDependencies": {
    "@mariachi/api-facade": "workspace:*",
    "@mariachi/auth": "workspace:*",
    "@mariachi/communication": "workspace:*",
    "@mariachi/config": "workspace:*",
    "@mariachi/database": "workspace:*",
    "@mariachi/database-postgres": "workspace:*",
    "@mariachi/jobs": "workspace:*",
    "@mariachi/lifecycle": "workspace:*",
    "@types/node": "^22",
    "drizzle-orm": "^0.38",
    "zod": "^3.24",
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
