{
  "name": "@mariachi/rate-limit",
  "version": "0.1.0",
  "description": "Rate limiting on Redis or memory: sliding window, fixed window and token bucket, with per-tenant tiers.",
  "mariachi": {
    "category": "security",
    "status": "beta",
    "useWhen": "Throttling callers (api-facade wires it per route) or metering per-tenant quotas",
    "entry": [
      "createRateLimiter",
      "DefaultRateLimiting"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "ioredis": "^5"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
