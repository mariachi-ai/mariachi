{
  "name": "@mariachi/search",
  "version": "0.1.0",
  "description": "Full-text search on Typesense (or memory) with typed fields, alias-based reindexing and query analytics.",
  "mariachi": {
    "category": "data",
    "status": "beta",
    "useWhen": "Search indexes over your data",
    "entry": [
      "createSearch",
      "DefaultSearch",
      "SearchIndexer"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "typesense": "^1.8"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
