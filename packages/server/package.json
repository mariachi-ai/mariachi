{
  "name": "@mariachi/server",
  "version": "1.0.0",
  "description": "HTTP transport on Fastify: request context, traceparent propagation, CORS, security headers, graceful close.",
  "mariachi": {
    "category": "http",
    "status": "beta",
    "useWhen": "Building a custom HTTP surface; apps normally use api-facade or webhooks on top of it",
    "entry": [
      "FastifyServerAdapter",
      "contextFromRequest"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "@mariachi/observability": "workspace:*",
    "fastify": "^5"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
