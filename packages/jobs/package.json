{
  "name": "@mariachi/jobs",
  "version": "0.0.5",
  "description": "Background jobs and cron on BullMQ with context propagation, retries, dedup and a dead-letter queue.",
  "mariachi": {
    "category": "async",
    "status": "beta",
    "useWhen": "Work that runs later, on a schedule, or must survive restarts",
    "entry": [
      "createJobQueue",
      "defineJob",
      "DefaultJobs"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "bullmq": "^5",
    "zod": "^3.24"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
