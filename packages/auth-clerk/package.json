{
  "name": "@mariachi/auth-clerk",
  "version": "1.0.0",
  "description": "Clerk token verification and Svix-signed webhooks.",
  "mariachi": {
    "category": "security",
    "status": "alpha",
    "useWhen": "Using Clerk as the identity provider",
    "entry": [
      "createClerkAuth",
      "ClerkWebhookController"
    ]
  },
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clerk/backend": "^1",
    "@mariachi/auth": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/server": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "svix": "^1"
  },
  "devDependencies": {
    "vitest": "^3"
  }
}
