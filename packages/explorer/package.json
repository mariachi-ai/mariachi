{
  "name": "@mariachi/explorer",
  "version": "0.0.5",
  "private": false,
  "description": "Explorer for the whole framework: packages, docs, API, error codes, dependency graph, CLI, tables and the design library, generated from the repo.",
  "mariachi": {
    "category": "tooling",
    "status": "alpha",
    "useWhen": "Browsing every package, API, error code and design component, locally (mariachi explore) or hosted",
    "entry": []
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist/site",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "astro build && pagefind --site dist/site --output-subdir pagefind",
    "dev": "astro dev",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "clean": "rm -rf dist .turbo .astro .cache",
    "lint": "biome lint src && stylelint \"src/**/*.css\"",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:browser": "playwright test --project=checks",
    "test": "vitest run --passWithNoTests",
    "test:visual": "playwright test --project=visual",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@mariachi/ai": "workspace:*",
    "@mariachi/api-facade": "workspace:*",
    "@mariachi/audit": "workspace:*",
    "@mariachi/auth": "workspace:*",
    "@mariachi/auth-clerk": "workspace:*",
    "@mariachi/auth-fusionauth": "workspace:*",
    "@mariachi/billing": "workspace:*",
    "@mariachi/cache": "workspace:*",
    "@mariachi/cli": "workspace:*",
    "@mariachi/communication": "workspace:*",
    "@mariachi/config": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/create": "workspace:*",
    "@mariachi/database": "workspace:*",
    "@mariachi/database-postgres": "workspace:*",
    "@mariachi/design": "workspace:*",
    "@mariachi/encryption": "workspace:*",
    "@mariachi/events": "workspace:*",
    "@mariachi/integrations": "workspace:*",
    "@mariachi/jobs": "workspace:*",
    "@mariachi/lifecycle": "workspace:*",
    "@mariachi/notifications": "workspace:*",
    "@mariachi/observability": "workspace:*",
    "@mariachi/rate-limit": "workspace:*",
    "@mariachi/realtime": "workspace:*",
    "@mariachi/schema": "workspace:*",
    "@mariachi/search": "workspace:*",
    "@mariachi/server": "workspace:*",
    "@mariachi/storage": "workspace:*",
    "@mariachi/tenancy": "workspace:*",
    "@mariachi/testing": "workspace:*",
    "@mariachi/webhooks": "workspace:*",
    "@shikijs/rehype": "4.5.0",
    "@types/hast": "3",
    "@types/mdast": "4",
    "astro": "7.4.1",
    "commander": "^13",
    "hast-util-to-string": "3.0.1",
    "mermaid": "12.2.0",
    "pagefind": "1.5.2",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.7",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vfile": "6",
    "vitest": "^3",
    "zod": "^3.25.76"
  }
}
