{
  "name": "@mariachi/api-facade",
  "version": "0.1.0",
  "description": "Public HTTP API: controllers, Zod-validated routes, auth strategies, rate limits, OpenAPI and health endpoints.",
  "mariachi": {
    "category": "http",
    "status": "beta",
    "useWhen": "Exposing REST endpoints to clients",
    "entry": [
      "createApiServer",
      "BaseController",
      "bearerStrategy",
      "apiKeyStrategy",
      "serviceTokenStrategy"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/communication": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/observability": "workspace:*",
    "@mariachi/rate-limit": "workspace:*",
    "@mariachi/server": "workspace:*",
    "zod": "^3",
    "zod-to-json-schema": "^3.24"
  },
  "devDependencies": {
    "@mariachi/storage": "workspace:^",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
