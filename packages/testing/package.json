{
  "name": "@mariachi/testing",
  "version": "1.0.0",
  "description": "Test doubles kept honest by contract suites shared with the real adapters, plus factories and a harness.",
  "mariachi": {
    "category": "tooling",
    "status": "beta",
    "useWhen": "Testing services without real infrastructure",
    "entry": [
      "createTestHarness",
      "createTestContext",
      "TestRepository"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/ai": "workspace:*",
    "@mariachi/cache": "workspace:*",
    "@mariachi/core": "workspace:*",
    "@mariachi/database": "workspace:*",
    "@mariachi/events": "workspace:*",
    "@mariachi/jobs": "workspace:*",
    "@mariachi/notifications": "workspace:*",
    "@mariachi/search": "workspace:*",
    "@mariachi/storage": "workspace:*",
    "zod": "^3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3",
    "@mariachi/database-postgres": "workspace:^",
    "drizzle-orm": "^0.38",
    "tsup": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
