{
  "name": "@mariachi/communication",
  "version": "0.0.5",
  "description": "Typed in-process procedure calls between controllers and services, with middleware, timeouts and scope checks.",
  "mariachi": {
    "category": "http",
    "status": "beta",
    "useWhen": "Controllers calling business logic (communication.call), never importing services",
    "entry": [
      "createCommunication",
      "defineProcedure"
    ]
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "lint": "biome lint src",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@mariachi/core": "workspace:*",
    "zod": "^3.24"
  },
  "devDependencies": {
    "typescript": "^5.7",
    "tsup": "^8",
    "vitest": "^3"
  }
}
